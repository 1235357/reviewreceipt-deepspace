<mxfile host="app.diagrams.net"><diagram name="reviewreceipt-method" id="reviewreceipt-method"><mxGraphModel grid="1" page="1" pageWidth="1200" pageHeight="720"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ReviewReceipt | Independent review method" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#152B3F;fontFamily=Times New Roman;"><mxGeometry x="40" y="30" width="1120" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="A shared decision record, not a proof of factual correctness." vertex="1" parent="1" style="text;html=1;align=left;fontSize=17;fontColor=#52687B;fontFamily=Times New Roman;"><mxGeometry x="40" y="80" width="1120" height="32" as="geometry" /></mxCell><mxCell id="task" value="&lt;b&gt;1. Freeze the task&lt;/b&gt;&lt;br&gt;Question, criteria, two candidate answers" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#71899B;fillColor=#E4F0FA;fontColor=#152B3F;fontSize=17;spacing=8;fontFamily=Times New Roman;"><mxGeometry x="40" y="170" width="240" height="110" as="geometry" /></mxCell><mxCell id="a" value="&lt;b&gt;2A. Reviewer A&lt;/b&gt;&lt;br&gt;Masked order A / B" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#71899B;fillColor=#EFF6F9;fontColor=#152B3F;fontSize=17;spacing=8;fontFamily=Times New Roman;"><mxGeometry x="355" y="140" width="240" height="96" as="geometry" /></mxCell><mxCell id="b" value="&lt;b&gt;2B. Reviewer B&lt;/b&gt;&lt;br&gt;Opposite order B / A" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#71899B;fillColor=#EFF6F9;fontColor=#152B3F;fontSize=17;spacing=8;fontFamily=Times New Roman;"><mxGeometry x="355" y="290" width="240" height="96" as="geometry" /></mxCell><mxCell id="lock" value="&lt;b&gt;3. Lock ballots&lt;/b&gt;&lt;br&gt;Judgments remain private until both submit" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#71899B;fillColor=#FFF4D7;fontColor=#152B3F;fontSize=17;spacing=8;fontFamily=Times New Roman;"><mxGeometry x="650" y="200" width="220" height="130" as="geometry" /></mxCell><mxCell id="result" value="&lt;b&gt;4. Reveal together&lt;/b&gt;&lt;br&gt;Map choices and reasons to original answers" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#71899B;fillColor=#DFF3E9;fontColor=#152B3F;fontSize=17;spacing=8;fontFamily=Times New Roman;"><mxGeometry x="930" y="200" width="230" height="130" as="geometry" /></mxCell><mxCell id="receipt" value="&lt;b&gt;5. Decision receipt&lt;/b&gt;&lt;br&gt;Reusable review record" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#71899B;fillColor=#DFF3E9;fontColor=#152B3F;fontSize=17;spacing=8;fontFamily=Times New Roman;"><mxGeometry x="930" y="420" width="230" height="95" as="geometry" /></mxCell><mxCell id="e0" value="" edge="1" parent="1" source="task" target="a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52687B;fontSize=14;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;exitX=1;exitY=0.25;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="197" /><mxPoint x="320" y="188" /></Array></mxGeometry></mxCell><mxCell id="e1" value="" edge="1" parent="1" source="task" target="b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52687B;fontSize=14;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;exitX=1;exitY=0.75;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="252" /><mxPoint x="320" y="338" /></Array></mxGeometry></mxCell><mxCell id="e2" value="Vote + reason" edge="1" parent="1" source="a" target="lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52687B;fontSize=14;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Vote + reason" edge="1" parent="1" source="b" target="lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52687B;fontSize=14;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Both locked" edge="1" parent="1" source="lock" target="result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52687B;fontSize=14;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" parent="1" source="result" target="receipt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52687B;fontSize=14;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note0" value="Guest demo: both reviewer slots operate locally on one device; no independent identities." vertex="1" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontSize=15;fontColor=#52687B;fontFamily=Times New Roman;"><mxGeometry x="40" y="580" width="1120" height="30" as="geometry" /></mxCell><mxCell id="note1" value="Shared mode: two assigned registered reviewers; production multi-account journey not fully verified." vertex="1" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontSize=15;fontColor=#52687B;fontFamily=Times New Roman;"><mxGeometry x="40" y="615" width="1120" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>