<mxfile host="app.diagrams.net"><diagram name="reviewreceipt-architecture" id="reviewreceipt-architecture"><mxGraphModel grid="0" page="1" pageWidth="1200" pageHeight="680"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Architecture: separate local review from shared room state" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#152D38;fontSize=30;align=left;verticalAlign=middle;spacing=12;fontFamily=Times New Roman;fontStyle=1;rounded=0;spacing=0;"><mxGeometry x="30" y="18" width="1140" height="44" as="geometry" /></mxCell><mxCell id="subtitle" value="The public example runs on one device. Shared review uses DeepSpace identity, actions, records and live subscriptions." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#48616C;fontSize=18;align=left;verticalAlign=middle;spacing=12;fontFamily=Times New Roman;rounded=0;spacing=0;"><mxGeometry x="30" y="63" width="1140" height="35" as="geometry" /></mxCell><mxCell id="browserpanel" value="" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#BCD0DC;fillColor=#E9F2F8;fontColor=#152D38;fontSize=18;align=left;verticalAlign=middle;spacing=12;fontFamily=Times New Roman;"><mxGeometry x="30" y="118" width="300" height="490" as="geometry" /></mxCell><mxCell id="platformpanel" value="" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#B7CEC4;fillColor=#EDF2F1;fontColor=#152D38;fontSize=18;align=left;verticalAlign=middle;spacing=12;fontFamily=Times New Roman;"><mxGeometry x="365" y="118" width="805" height="490" as="geometry" /></mxCell><mxCell id="browserh" value="Browser clients" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#1D537A;fontSize=20;align=left;verticalAlign=middle;spacing=12;fontFamily=Times New Roman;fontStyle=1;rounded=0;spa